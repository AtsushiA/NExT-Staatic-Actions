<?xml version="1.0"?>
<ruleset name="NExT Staatic Actions">
    <description>Custom ruleset for NExT Staatic Actions</description>

    <!-- Target files -->
    <file>./next-staatic-actions.php</file>
    <file>./uninstall.php</file>
    <file>./src</file>
    <file>./tests</file>

    <!-- Exclusions -->
    <exclude-pattern>./vendor/*</exclude-pattern>
    <exclude-pattern>./node_modules/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <!-- WordPress Coding Standards -->
    <rule ref="WordPress">
        <!--
            This plugin uses namespaced, PSR-4-autoloaded classes with camelCase
            methods/properties/variables (matching Staatic's own coding style),
            not WordPress core's traditional snake_case/procedural conventions.
            Naming and file-naming sniffs are excluded as a deliberate architecture
            choice; the rest of WordPress (security, i18n, formatting, best
            practices) still applies.
        -->
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName"/>
        <exclude name="WordPress.Files.FileName"/>

        <!--
            Mandatory docblocks-on-everything are intentionally not enforced here;
            this project prefers self-documenting names/types and comments only
            where the WHY isn't obvious from the code.
        -->
        <exclude name="Squiz.Commenting"/>
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>

        <!-- Yoda conditions are a stylistic preference this project doesn't follow. -->
        <exclude name="WordPress.PHP.YodaConditions"/>
    </rule>

    <!-- PHP compatibility -->
    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="7.4-8.4"/>

    <!-- Text domain -->
    <config name="text_domain" value="next-staatic-actions"/>

    <!-- Minimum WordPress version -->
    <config name="minimum_wp_version" value="5.0"/>

    <!--
        The Staatic stand-ins used only by tests intentionally pack several
        small classes across multiple namespaces into one file, mirroring
        Staatic's own PSR-4 layout without redistributing its source; the
        one-namespace/one-class-per-file sniffs don't apply to that file.
    -->
    <rule ref="Universal.Namespaces.OneDeclarationPerFile">
        <exclude-pattern>./tests/phpunit/stubs/staatic-stubs.php</exclude-pattern>
    </rule>
    <rule ref="Universal.Namespaces.DisallowCurlyBraceSyntax">
        <exclude-pattern>./tests/phpunit/stubs/staatic-stubs.php</exclude-pattern>
    </rule>
    <rule ref="Universal.Namespaces.DisallowDeclarationWithoutName">
        <exclude-pattern>./tests/phpunit/stubs/staatic-stubs.php</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.OneObjectStructurePerFile">
        <exclude-pattern>./tests/phpunit/stubs/staatic-stubs.php</exclude-pattern>
    </rule>
    <rule ref="Universal.Operators.DisallowShortTernary">
        <exclude-pattern>./tests/phpunit/stubs/staatic-stubs.php</exclude-pattern>
    </rule>
</ruleset>
