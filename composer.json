{
    "name": "next-season/next-staatic-actions",
    "description": "Fires email, Cloudflare cache purge, and webhook actions when Staatic finishes publishing.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "yoast/wp-test-utils": "^1.2"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "NExT\\StaaticActions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NExT\\StaaticActions\\Tests\\": "tests/phpunit/"
        }
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration --bootstrap=tests/phpunit/bootstrap.php"
    }
}
